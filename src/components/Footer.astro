---
const today = new Date();
---

<footer class="py-8">
  <div class="content-shell content-shell--flush">
    <div class="grid gap-6 pt-8 pb-4 md:flex md:items-center md:justify-between">
      <p class="text-sm text-muted m-0">{'That Christian Coder'} &copy; {today.getFullYear()}.</p>
      <p class="text-sm text-subtle m-0">
        Build with
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-transparent hover:decoration-current"
        >
          Astro
        </a>
        +
        <a
          href="https://github.com/roicort/dasein"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-transparent hover:decoration-current"
        >
          Dasein
        </a>
      </p>
    </div>
  </div>
</footer>
