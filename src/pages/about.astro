---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="About"
	description="Faith + code + life."
>
	<section class="content-shell py-12 space-y-8"> 
		<div class="space-y-3 max-w-3xl">
			<p class="m-0 text-ink text-2xl font-semibold leading-tight">I am building in public at the intersection of faith and software engineering.</p>
			<p class="m-0 text-muted">This site documents what I am learning: shipping code, thinking clearly, and staying grounded in Christian conviction.</p>
			<p class="m-0 text-muted">The goal is simple: write honestly, build useful things, and keep growing one project at a time.</p>
		</div>
	</section>
</PageLayout>
