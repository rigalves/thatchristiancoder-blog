---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="wtrfll" description="A focused build by thatchristiancoder.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-2">
			<p class="text-sm uppercase tracking-[0.3em] text-muted">Project</p>
			<h1 class="text-4xl font-semibold text-ink">wtrfll</h1>
		</header>

		<div class="max-w-3xl space-y-4">
			<p class="m-0 text-muted">
				wtrfll is where I am building intentionally: clean design, focused features, and thoughtful iteration.
			</p>
			<p class="m-0 text-muted">
				I will use this page to share progress, decisions, and what I am learning while shipping the project.
			</p>
		</div>
	</section>
</PageLayout>
